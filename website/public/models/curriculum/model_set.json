{
  "schemaVersion": 1,
  "format": "p2.better_ffn.curriculum.webgpu",
  "defaultStage": "flop",
  "source": {
    "exporter": "website.python.export_model",
    "curriculum": "promoted postflop street checkpoints",
    "promotedCheckpoints": {
      "flop": "S_flop",
      "turn": "S_turn",
      "river": "S_river"
    }
  },
  "streets": {
    "flop": {
      "label": "S_flop",
      "manifest": "S_flop/model.json"
    },
    "turn": {
      "label": "S_turn",
      "manifest": "S_turn/model.json"
    },
    "river": {
      "label": "S_river",
      "manifest": "S_river/model.json"
    }
  },
  "metadata": {
    "description": "Descriptor for locally exported curriculum assets. Generate the referenced stage directories with website/python/export_model.py --curriculum."
  }
}
